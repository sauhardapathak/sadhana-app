{
  "expo": {
    "name": "Sādhana",
    "slug": "sadhana-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "sadhana",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sadhana.app"
    },
    "android": {
      "package": "com.sadhana.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#F5EFE6"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5EFE6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f3fe79bf-496c-4ecc-8ebf-731793b0f063"
      }
    },
    "owner": "sauharda1"
  }
}
